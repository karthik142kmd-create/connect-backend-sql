<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show All Users</title>
    <style>
        table,th,tr,td{
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Email</th>
        </tr>
        <% for(let i=0;i<100;i++){ %>
            <tr>
                <td><%= res1[i].id %></td>
                <td><%= res1[i].username %></td>
                <td><%= res1[i].email %></td>
                <td>
                    <form method="get" action="/user/<%= res1[i].id %>/edit">
                        <button>Edit</button>
                    </form>
                </td>
            </tr>
        <% } %>
    </table>
</body>
</html>